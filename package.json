{
	"name": "pdf2md-local",
	"version": "0.7.1",
	"description": "Local PDF to Markdown for maths and science, with an Obsidian plugin.",
	"main": "main.js",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"test": "esbuild src/runner.ts --bundle --format=esm --platform=node --outfile=.test-build/runner.mjs --log-level=warning && node --test tests/*.test.mjs",
		"test:py": "python3 -m unittest discover -s tests/python"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"obsidian": "^1.14.4",
		"tslib": "^2.9.1",
		"typescript": "^7.0.2"
	}
}
